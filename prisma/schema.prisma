
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id           String   @id @default(cuid())
  name         String
  groupCode    String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members  Member[]
  expenses Expense[]
}

model Member {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  groupId        String
  createdAt      DateTime @default(now())

  group          Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidExpenses   Expense[]      @relation("ExpensePayer")
  shares         ExpenseShare[]

  @@unique([groupId, normalizedName])
  @@index([groupId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Int
  groupId     String
  payerId     String
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer  Member         @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  shares ExpenseShare[]

  @@index([groupId, expenseDate])
  @@index([payerId])
}

model ExpenseShare {
  id        String @id @default(cuid())
  expenseId String
  memberId  String
  amount    Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([expenseId, memberId])
  @@index([memberId])
}
